# Configuración del Entorno - Sistema de Turnos IESS (Prototipo Académico)

NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
DB_USER=iess_user
DB_PASSWORD=iess_secure_pwd2026
DB_NAME=iess_turnos_db
DB_HOST=localhost
DB_PORT=5434
DATABASE_URL="postgresql://iess_user:iess_secure_pwd2026@localhost:5434/iess_turnos_db?schema=public"

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_2026
JWT_EXPIRATION=3600s

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Simulación de servicios IESS
IESS_MOCK_FAILURE_RATE=0.0

